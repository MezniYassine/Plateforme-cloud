@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:host {
  /* ── Font families ── */
  --font-display: 'Space Grotesk', sans-serif;
  --font-ui:      'Inter', sans-serif;

  /* ── Orange palette ── */
  --accent:        hsl(28, 99%, 54%);
  --accent-dim:    hsla(28, 99%, 54%, 0.10);
  --accent-border: hsla(28, 99%, 54%, 0.28);
  --accent-glow:   hsla(28, 99%, 54%, 0.45);

  --bg-base:    #f5f7f5;
  --bg-card:    #fdfcfb;
  --bg-card-h:  #ffffff;

  --text-white: #111411;
  --text-muted: #3a4b3a;
  --text-dim:   #5a6b5a;

  --border: rgba(0, 0, 0, 0.12);

  /* cube colors */
  --c-dark:  #f0f2f0;
  --c-mid:   #f7f8f7;
  --c-light: #ffffff;

  display: block;
  font-family: var(--font-ui);
  background: var(--bg-base);
  color: var(--text-white);
  min-height: 100vh;
  overflow-x: hidden;
}

/* ═══════════════════════════════════════
   GLOBAL CUBE GRID  —  position:fixed
   Covers the entire viewport at all times
═══════════════════════════════════════ */
.cube-grid-bg {
  position: fixed;
  top: 0; bottom: 0; left: 0; right: 0;
  z-index: 0;
  display: grid;
  /* Fixed 76px columns so JS position math is exact */
  grid-template-columns: repeat(auto-fill, 76px);
  grid-template-rows:    repeat(auto-fill, 76px);
  gap: 3px;
  overflow: hidden;
  pointer-events: none; /* clicks pass through to content */
}

/* Base cube tile */
.cube-tile {
  background: linear-gradient(145deg, var(--c-light) 0%, var(--c-mid) 40%, var(--c-dark) 100%);
  border-radius: 1px;
  /* bevel */
  box-shadow:
    inset  1px  1px 0 rgba(255, 255, 255, 1),
    inset -1px -1px 0 rgba(0,   0,   0,   0.03);
  transition: background 0.1s ease-out, box-shadow 0.1s ease-out;
}

/* Random ambient glow (slow, subtle) */
.cube-tile.cube-glow {
  animation-name: tile-ambient;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

@keyframes tile-ambient {
  0%, 100% {
    background: linear-gradient(145deg, var(--c-light) 0%, var(--c-mid) 40%, var(--c-dark) 100%);
  }
  50% {
    background: linear-gradient(145deg, hsla(28,99%,54%,.18) 0%, #fef8f4 40%, #fcf0e8 100%);
    box-shadow:
      inset 1px 1px 0 hsla(28,99%,54%,.10),
      0 0 12px hsla(28,99%,54%,.10);
  }
}

/* ★ HOVER GLOW — triggered from JS */
.cube-tile.cube-hover {
  background: linear-gradient(145deg,
    hsla(28, 99%, 54%, 0.55) 0%,
    #fef0e5                  45%,
    #fce4d6                  100%
  ) !important;
  box-shadow:
    inset  1px  1px 0 hsla(28, 99%, 54%, 0.3),
    0 0 22px hsla(28, 99%, 54%, 0.28),
    0 0 50px hsla(28, 99%, 54%, 0.10) !important;
}

/* ═══════════════════════════════════════
   ALL CONTENT — z-index 1 to sit above grid
═══════════════════════════════════════ */
nav,
section,
footer {
  position: relative;
  z-index: 1;
}

/* ═══════════════════════════════════════
   NAVBAR
═══════════════════════════════════════ */
nav {
  position: fixed; top: 0; left: 0; right: 0;
  display: flex; justify-content: space-between; align-items: center;
  padding: 24px 64px; z-index: 100;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(0, 0, 0, 0.03);
}

.nav-logo          { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.nav-logo-icon     { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.nav-logo-icon img { width: 100%; height: 100%; object-fit: contain; display: block; }
.nav-logo-icon-sm  { width: 28px; height: 28px; }
.nav-logo-text     { font-family: var(--font-display); font-weight: 600; font-size: 15px; letter-spacing: .02em; color: var(--text-white); }

.nav-links { display: flex; gap: 32px; list-style: none; align-items: center; }
.nav-links a {
  font-size: 13px; font-weight: 600; color: var(--text-white); text-decoration: none;
  letter-spacing: .08em; text-transform: uppercase;
  padding-bottom: 4px; border-bottom: 2px solid transparent;
  transition: color .2s, border-color .2s;
}
.footer-links a:hover { color: var(--accent); }

/* ═══════════════════════════════════════
═══════════════════════════════════════ */
.contact-section {
  padding: 80px 0 40px;
  background: transparent;
}
.contact-container {
  max-width: 600px;
  margin: 0 auto;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 48px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.06);
}
.contact-form .form-row {
  display: flex;
  gap: 24px;
  margin-bottom: 24px;
}
.contact-form .form-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-bottom: 24px;
}
.contact-form .form-row .form-group {
  margin-bottom: 0;
}
.contact-form label {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-white);
  margin-bottom: 8px;
  letter-spacing: .02em;
}
.contact-form input,
.contact-form textarea {
  background: var(--bg-base);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 14px 16px;
  font-family: inherit;
  font-size: 14px;
  color: var(--text-white);
  transition: border-color .2s, box-shadow .2s;
  outline: none;
}
.contact-form input::placeholder,
.contact-form textarea::placeholder {
  color: var(--text-muted);
}
.contact-form input:focus,
.contact-form textarea:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px hsla(28,99%,54%,.15);
}
.contact-submit {
  width: 100%;
  margin-top: 8px;
  text-align: center;
}
.contact-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  filter: grayscale(100%);
}
.contact-alert {
  margin-top: 24px;
  padding: 14px;
  border-radius: 4px;
  font-size: 13.5px;
  font-weight: 500;
  text-align: center;
}
.contact-alert.success {
  background: hsla(142,71%,45%,.1);
  color: #16a34a;
  border: 1px solid hsla(142,71%,45%,.2);
}
.contact-alert.error {
  background: hsla(0,84%,60%,.1);
  color: #ef4444;
  border: 1px solid hsla(0,84%,60%,.2);
}



.nav-links a:hover { color: var(--accent); border-bottom-color: var(--accent); }

.nav-actions { display: flex; gap: 16px; align-items: center; }

.btn-ghost {
  font-family: var(--font-ui);
  font-size: 11px; font-weight: 500; color: var(--text-muted);
  background: none; border: none; padding: 8px 16px; border-radius: 4px;
  cursor: pointer; transition: color .2s, background .2s;
  text-decoration: none; letter-spacing: .1em; text-transform: uppercase;
}
.btn-ghost:hover { color: var(--text-white); background: rgba(255,255,255,.05); }

.btn-primary {
  font-family: var(--font-ui);
  font-size: 11px; font-weight: 700; color: #000;
  background: var(--accent); border: none;
  padding: 9px 22px; border-radius: 3px; cursor: pointer;
  transition: filter .2s, transform .15s;
  text-decoration: none; display: inline-block;
  letter-spacing: .08em; text-transform: uppercase;
}
.btn-primary:hover { filter: brightness(1.15); transform: translateY(-1px); }

/* ═══════════════════════════════════════
   HERO — transparent so cubes show through
═══════════════════════════════════════ */
.hero-section {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  /* NO background — cubes show through completely */
}

/* Hero overlay removed to clean up isolated decorative elements */

/* Hero content */
.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 860px;
  padding: 120px 40px 60px;
  pointer-events: none;   /* cursor passes to cube grid below */
}

.hero-badge {
  display: inline-flex; align-items: center; gap: 9px;
  background: var(--accent-dim);
  border: 1px solid var(--accent-border);
  border-radius: 100px; padding: 6px 18px;
  font-size: 11.5px; font-weight: 500; color: var(--accent);
  margin-bottom: 36px; letter-spacing: .07em;
}

.hero-badge-dot {
  display: block; width: 6px; height: 6px;
  background: var(--accent); border-radius: 50%;
  flex-shrink: 0;
  animation: badge-pulse 2s ease-in-out infinite;
  box-shadow: 0 0 8px var(--accent);
}
@keyframes badge-pulse {
  0%,100% { opacity:1; transform:scale(1); }
  50%      { opacity:.35; transform:scale(.65); }
}

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 7vw, 5.5rem);
  font-weight: 600; line-height: 1.1;
  letter-spacing: -0.01em; color: var(--text-white);
  margin-bottom: 24px; text-transform: none;
}
.accent-text {
  color: var(--accent);
  text-shadow: 0 0 50px var(--accent-glow);
}

.hero-subtitle {
  font-size: clamp(.95rem, 2vw, 1.2rem); font-weight: 400; line-height: 1.75;
  color: #111;
  max-width: 580px; margin: 0 auto 14px;
}
.hero-desc {
  font-size: clamp(.8rem, 1.3vw, .95rem); font-weight: 300; line-height: 1.8;
  color: var(--text-muted);
  max-width: 520px; margin: 0 auto 40px;
}

.hero-actions {
  display: flex; flex-wrap: wrap; gap: 14px;
  justify-content: center;
  pointer-events: auto;   /* re-enable clicks on buttons */
  margin-bottom: 28px;
}

.btn-hero-primary {
  font-family: var(--font-ui);
  font-size: 13px; font-weight: 700; color: #000;
  background: var(--accent); border: none;
  padding: 14px 34px; border-radius: 3px; cursor: pointer;
  box-shadow: 0 0 32px var(--accent-glow);
  transition: filter .2s, transform .15s, box-shadow .2s;
  text-decoration: none; display: inline-block;
  text-transform: uppercase; letter-spacing: .05em;
}
.btn-hero-primary:hover { filter:brightness(1.12); transform:translateY(-2px); box-shadow:0 0 54px var(--accent-glow); }
.btn-hero-primary:active { transform:scale(.97); }

.btn-hero-outline {
  font-family: var(--font-ui);
  font-size: 13px; font-weight: 700; color: #111411;
  background: #ffffff;
  border: 2px solid #e2e8f0;
  padding: 13px 33px; border-radius: 3px; cursor: pointer;
  transition: all .2s;
  text-decoration: none; display: inline-block;
  text-transform: uppercase; letter-spacing: .05em;
}
.btn-hero-outline:hover { background: var(--accent); border-color: var(--accent); color: #ffffff; transform:translateY(-2px); }
.btn-hero-outline:active { transform:scale(.97); }

.hero-trust {
  font-size: 11px; font-weight: 300; pointer-events: none;
  color: rgba(110,126,110,.55); letter-spacing: .05em;
}

/* ═══════════════════════════════════════
   SECTION COMMON
   Semi-opaque so cubes bleed through subtly
═══════════════════════════════════════ */
.section-inner {
  max-width: 1280px; margin: 0 auto; padding: 80px 64px;
}
.section-header { text-align: center; margin-bottom: 64px; }

.section-title {
  font-family: var(--font-display);
  font-size: clamp(32px, 5vw, 44px); font-weight: 600;
  color: var(--text-white); margin-bottom: 16px; letter-spacing: -.02em;
}
.section-title::after, .cta-title::after {
  content: ''; display: block; width: 40px; height: 3px;
  background: var(--accent); margin: 16px auto 0; border-radius: 2px;
}
.section-sub {
  font-size: 15px; font-weight: 300; color: var(--text-muted);
  max-width: 480px; margin: 0 auto; line-height: 1.8;
}

/* ═══════════════════════════════════════
   CORE INFRASTRUCTURE
═══════════════════════════════════════ */
.core-section {
  position: relative; z-index: 2; padding: 80px 0 40px;
  background: transparent;
  border-top: none;
}

.cards-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 40px;
  align-items: stretch;
}
.infra-card {
  display: flex; flex-direction: column; height: 100%;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 8px; padding: 56px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  cursor: pointer; transition: transform .25s, box-shadow .25s, border-color .25s, background .25s;
}
.infra-card:hover {
  background: var(--bg-card-h);
  border-color: var(--accent-border);
  box-shadow: 0 0 32px var(--accent-dim);
  transform: translateY(-4px);
}
.infra-card.active {
  background: var(--bg-card-h);
  border-color: var(--accent);
  box-shadow: 0 0 40px var(--accent-glow);
}

.card-icon {
  width: 56px; height: 56px;
  background: linear-gradient(135deg, var(--accent-dim) 0%, transparent 100%);
  border: 1px solid var(--accent-border);
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24px;
  transition: background .25s, box-shadow .25s;
}
.infra-card:hover .card-icon { background: var(--accent-dim); box-shadow: 0 0 20px var(--accent-dim); }
.card-icon svg { width: 28px; height: 28px; }

.card-title {
  font-family: var(--font-display);
  font-size: 20px; font-weight: 700; color: var(--text-white);
  margin-bottom: 12px; letter-spacing: 0;
}
.card-desc {
  font-size: 13.5px; font-weight: 400; color: var(--text-dim);
  line-height: 1.78; margin-bottom: 24px; flex-grow: 1;
}
.card-link {
  font-size: 12.5px; font-weight: 500; color: var(--accent);
  text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
  transition: gap .2s;
  pointer-events: none; /* handled by card click */
}
.infra-card:hover .card-link { gap: 10px; }

/* ═══════════════════════════════════════
   CATALOG DISPLAY
═══════════════════════════════════════ */
.catalog-display {
  margin-top: 24px;
  background: #fafafa;
  border: 1px solid var(--border);
  box-shadow: inset 0 2px 12px rgba(0,0,0,0.02), 0 10px 30px rgba(0,0,0,0.05);
  border-radius: 8px;
  padding: 40px;
  display: none;
}
.catalog-display.show {
  display: block;
}

.catalog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32px;
  border-bottom: 1px solid var(--border);
  padding-bottom: 16px;
}

.catalog-header h3 {
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 700;
  color: var(--text-white);
  margin: 0;
}

.btn-close {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 28px;
  cursor: pointer;
  line-height: 1;
  width: 40px; height: 40px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  transition: color 0.2s, background 0.2s;
}
.btn-close:hover {
  color: var(--text-white);
  background: rgba(0,0,0,0.06);
}

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 60px;
}

.catalog-item {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 24px;
  display: flex;
  gap: 16px;
  align-items: flex-start;
  box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
  cursor: pointer;
}
.catalog-item:hover {
  background: var(--bg-card-h);
  border-color: var(--accent-border);
}

.catalog-item-icon {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  background: var(--bg-base);
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px;
}
.catalog-item-icon img, .catalog-item-icon svg {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.catalog-item-info h4 {
  font-family: var(--font-ui);
  font-size: 16px;
  font-weight: 700;
  color: var(--text-white);
  margin: 0 0 6px 0;
}
.catalog-item-info p {
  font-size: 13px;
  font-weight: 400;
  color: var(--text-dim);
  line-height: 1.5;
  margin: 0;
}

.catalog-item-price {
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 700;
  color: var(--accent);
  margin-top: 8px;
  background: var(--accent-dim);
  display: inline-block;
  padding: 6px 12px;
  border-radius: 4px;
}

/* ═══════════════════════════════════════
   STATS
═══════════════════════════════════════ */
.stats-section {
  background: transparent;
  border-top: 1px solid rgba(0, 0, 0, 0.05);
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}
.stats-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
}
.stat-item {
  padding: 56px 40px; text-align: center;
  border-right: 1px solid var(--border);
  background: #ffffff;
  box-shadow: 0 4px 16px rgba(0,0,0,0.04);
  transition: background .3s;
  &:last-child { border-right: none; }
  &:hover      { background: var(--bg-card-h); }
}
.stat-number {
  font-family: var(--font-display);
  font-size: 46px; font-weight: 700; color: var(--text-white);
  letter-spacing: -.02em; margin-bottom: 8px; line-height: 1;
}
.stat-number span { color: var(--accent); text-shadow: 0 0 24px var(--accent-glow); }
.stat-label { font-size: 11px; font-weight: 400; color: var(--text-muted); letter-spacing: .08em; text-transform: uppercase; }

/* ═══════════════════════════════════════
   FEATURES
═══════════════════════════════════════ */
#solutions {
  background: transparent;
  padding: 80px 0 40px;
}
.features-grid {
  display: grid; grid-template-columns: repeat(2, 1fr);
  border: 1px solid var(--border); border-radius: 4px; overflow: hidden;
  align-items: stretch;
}
.feature-card {
  height: 100%;
  background: var(--bg-card);
  padding: 32px; display: flex; gap: 20px; align-items: flex-start;
  border-right: 1px solid var(--border); border-bottom: 1px solid var(--border);
  box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  transition: background .25s;
  &:nth-child(2n)        { border-right: none; }
  &:nth-last-child(-n+2) { border-bottom: none; }
  &:hover                { background: var(--bg-card-h); }
}
.feature-icon {
  width: 56px; height: 56px; flex-shrink: 0;
  background: linear-gradient(135deg, var(--accent-dim) 0%, transparent 100%);
  border: 1px solid var(--accent-border);
  border-radius: 12px; display: flex; align-items: center; justify-content: center;
  transition: background .25s, box-shadow .25s;
}
.feature-card:hover .feature-icon { background: hsla(28,99%,54%,.18); box-shadow: 0 0 16px hsla(28,99%,54%,.14); }
.feature-icon svg { width: 26px; height: 26px; }

.feature-title {
  font-family: var(--font-display);
  font-size: 15px; font-weight: 600; color: var(--text-white); margin-bottom: 8px;
}
.feature-desc { font-size: 13px; font-weight: 300; color: var(--text-muted); line-height: 1.72; }

/* ═══════════════════════════════════════
   CTA
═══════════════════════════════════════ */
.cta-section {
  background: transparent;
  padding: 40px 0 80px;
}
.cta-box {
  background: hsla(28,99%,54%,.15);
  border: 1px solid hsla(28,99%,54%,.25);
  border-radius: 6px; padding: 80px; text-align: center;
  position: relative; overflow: hidden;
  /* Removed isolated radial-gradient decorative element */
}
.cta-title {
  font-family: var(--font-display);
  font-size: clamp(32px, 5vw, 44px); font-weight: 600;
  color: var(--text-white); letter-spacing: -.01em; margin-bottom: 16px; position: relative;
}
.cta-sub { font-size: 15px; font-weight: 300; color: var(--text-muted); margin-bottom: 40px; position: relative; }
.cta-actions { display: flex; justify-content: center; gap: 14px; position: relative; }

/* ═══════════════════════════════════════
   FOOTER
═══════════════════════════════════════ */
footer {
  border-top: 1px solid rgba(0, 0, 0, 0.05);
  padding: 48px 64px;
  max-width: 1280px; margin: 0 auto;
  display: flex; align-items: center; justify-content: space-between;
  background: transparent;
}
.footer-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.footer-copy { font-size: 12px; font-weight: 300; color: var(--text-dim); }
.footer-links { display: flex; gap: 28px; }
.footer-links a { font-size: 12px; color: var(--text-dim); text-decoration: none; transition: color .2s; }
.footer-links a:hover { color: var(--text-muted); }

/* ═══════════════════════════════════════
   FADE-UP ANIMATIONS
═══════════════════════════════════════ */
.fade-up {
  opacity: 0;
  transform: translateY(26px);
  filter: blur(5px);
  animation: fade-up-in 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes fade-up-in {
  to { opacity:1; transform:translateY(0); filter:blur(0); }
}
.delay-1 { animation-delay: .2s; }
.delay-2 { animation-delay: .4s; }
.delay-3 { animation-delay: .55s; }
.delay-4 { animation-delay: .7s; }
.delay-5 { animation-delay: .85s; }

/* ═══════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════ */
@media (max-width: 1024px) {
  .cards-grid { grid-template-columns: repeat(2, 1fr); }
  .infra-card:last-child { grid-column: 1/-1; border-right: none; border-top: 1px solid var(--border); }
  .section-inner { padding: 80px 40px; }
  .cta-box { padding: 60px 40px; }
}

@media (max-width: 768px) {
  nav { padding: 0 20px; }
  .nav-links, .btn-ghost { display: none; }
  .hero-content { padding: 120px 20px 60px; }
  .hero-title { font-size: clamp(2.4rem, 10vw, 3.2rem); }

  .cards-grid { grid-template-columns: 1fr; }
  .infra-card { border-right: none; border-bottom: 1px solid var(--border); }
  .infra-card:last-child { border-bottom: none; }

  .features-grid { grid-template-columns: 1fr; }
  .feature-card { border-right: none; }
  .feature-card:last-child { border-bottom: none; }

  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .stat-item:nth-child(2)  { border-right: none; }
  .stat-item:nth-child(3)  { border-top: 1px solid var(--border); }
  .stat-item:nth-child(4)  { border-top: 1px solid var(--border); border-right: none; }

  .section-inner { padding: 64px 20px; }
  .cta-box { padding: 48px 20px; }
  .cta-actions { flex-direction: column; align-items: center; }
  footer { flex-direction: column; gap: 20px; text-align: center; padding: 40px 20px; }
}
